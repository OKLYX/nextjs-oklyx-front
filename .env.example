# Environment files (Next.js loads by command; .env.local always wins).
#
#   .env.development  -> `next dev`   : NEXT_PUBLIC_SERVER_API_URL=http://localhost:8083  (committed)
#   .env.production   -> `next build` : NEXT_PUBLIC_SERVER_API_URL=https://api.oclyx.com   (committed)
#   .env.local        -> always       : optional personal override, git-ignored, empty by default
#
# Only NEXT_PUBLIC_* vars are exposed to the browser and are inlined at build time.
# DEV/PROD container images inject NEXT_PUBLIC_SERVER_API_URL via Docker --build-arg.

# Backend API base URL (used by axios + server routes).
NEXT_PUBLIC_SERVER_API_URL=

# Personal override example: point local frontend at the DEV backend.
# NEXT_PUBLIC_SERVER_API_URL=https://api-dev.oclyx.com
