# Loaded by `next build` / `next start`. Local production builds hit prod.
# NOTE: DEV/PROD container images override this at build time via Docker
# --build-arg NEXT_PUBLIC_SERVER_API_URL (see 02_INFRA / GitHub Secrets).
# So this value only matters for a local `npm run build`.
NEXT_PUBLIC_SERVER_API_URL=https://api.oclyx.com
